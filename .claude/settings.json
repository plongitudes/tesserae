{
  "permissions": {
    "allow": [
      "Bash(tess *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v tess >/dev/null 2>&1 && tess hook session-start || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v tess >/dev/null 2>&1 && tess hook session-end || true"
          }
        ]
      }
    ]
  }
}
