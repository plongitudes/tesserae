# Agent-grade CLI: orientation, help, error shapes (ADR-0019).

exec git init -q .
exec tess init --prefix t

# No arguments: an orientation that names every working command and no plumbing.
exec tess
stdout 'tess ready'
stdout 'tess create'
stdout 'tess show'
stdout 'tess update'
stdout 'tess status'
stdout 'tess comment'
stdout 'tess link'
stdout 'tess unlink'
stdout 'tess list'
stdout 'tess retire'
stdout 'tess restore'
stdout 'tess sync'
! stdout 'tess init'
! stdout 'tess import'
! stdout 'tess setup'
! stdout 'tess hook'

# Every command's --help has examples.
exec tess create --help
stdout 'Examples'
exec tess status --help
stdout 'Examples'
stdout 'ready'
stdout 'pending-review'
exec tess list --help
stdout 'Examples'
exec tess ready --help
stdout 'Examples'
exec tess update --help
stdout 'Examples'
exec tess link --help
stdout 'Examples'
stdout 'blocked-by'
exec tess show --help
stdout 'Examples'
exec tess retire --help
stdout 'Examples'

# Help reads as syntax: a full synopsis with CAPS placeholders, never a Go
# type name or "[flags]" (cli.md, Output).
exec tess create --help
stdout '^  tess create TITLE \['
stdout '--label LABEL'
stdout '--priority N'
! stdout 'string'
! stdout '\[flags\]'
exec tess link --help
stdout '^  tess link ID\.\.\. TYPE ID\.\.\.'
exec tess show --help
stdout '^  tess show ID --field FIELD'
! stdout '\[flags\]'
exec tess update --help
! stdout 'string'
exec tess list --help
! stdout 'string'
! stdout '\[flags\]'

# JSON errors: code, message, hint; exit 1.
! exec tess show t-zzzzzzzz --json
json stderr .error.code not_found
stderr '"message"'
stderr '"hint"'
! stdout .

# Plain errors start with "error:" and never use the omit symbol.
! exec tess show t-zzzzzzzz
stderr '^error: '
! stderr '✗'

# Unknown commands and flags.
! exec tess frobnicate --json
json stderr .error.code invalid_argument
! exec tess list --frobnicate --json
json stderr .error.code invalid_argument

# Command-line errors print usage, not a hint; the JSON hint is the use line.
! exec tess create
stderr '^error: '
stderr '^usage: tess create'
stderr 'tess create --help'
! stderr '^hint: '
! exec tess link t-aaa
stderr '^usage: tess link ID\.\.\. TYPE ID\.\.\.'
! exec tess link t-aaa --json
json stderr .error.code invalid_argument
stderr '"hint":"tess link'

# Refusals keep their hint.
! exec tess show t-zzzzzzzz
stderr '^hint: '
! stderr '^usage: '
